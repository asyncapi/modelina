{
  "name": "modelina-website",
  "private": true,
  "scripts": {
    "dev": "npm run build:resources && cross-env NODE_OPTIONS='--inspect' next dev",
    "build": "npm run build:resources && next build",
    "build:modelina": "cd .. && npm i && npm run build:prod && npm run docs:api",
    "export": "next build",
    "start": "next start",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "build:resources": "npm run build:examples && npm run build:docs && npm run copy:docs:img",
    "build:examples": "node scripts/build-examples.js",
    "build:docs": "node scripts/build-docs.js",
    "copy:docs:img": "node scripts/copy-docs-img.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@netlify/functions": "^1.4.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tippyjs/react": "^4.2.6",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "cssnano": "^5.1.14",
    "framer-motion": "^12.34.0",
    "immer": "^10.1.1",
    "js-base64": "^3.7.4",
    "lodash": "^4.18.0",
    "lowlight": "^1.12.1",
    "next": "^16.1.6",
    "postcss": "^8.4.31",
    "prettier": "^3.3.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^4.12.0",
    "react-markdown": "^9.1.0",
    "react-syntax-highlighter": "15.5.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "swiper": "^8.3.2",
    "tailwind-merge": "^1.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash": "^4.14.191",
    "@types/lowlight": "0.0.3",
    "@types/node": "^20.19.33",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.6",
    "autoprefixer": "^10.4.13",
    "cross-env": "^7.0.3",
